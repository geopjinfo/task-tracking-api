{
  "name": "task-tracking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "load:smoke": "node scripts/load-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:openapi && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.1.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.1.7",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "redis": "^5.9.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@redocly/cli": "^2.65.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8",
    "yaml": "^2.9.1"
  }
}
